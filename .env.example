# Copy to .env and fill in. .env is gitignored.

# Storage
SA_DATA_DIR=./data
SA_DB_PATH=./data/stockanalysis.duckdb

# Ingest politeness — these are unofficial APIs over public sites.
# Do not lower these. Getting IP-blocked is the main phase-1 operational risk.
SA_REQUEST_DELAY_SECONDS=1.0
SA_MAX_RETRIES=4

# Universe
SA_DEFAULT_INDEX=NIFTY100

# Backtest defaults
SA_REBALANCE_FREQ=M
SA_TOP_N=20

# Phase 1+ (not used in phase 0)
# ANTHROPIC_API_KEY=

# Phase 1 — extraction. The anthropic SDK reads ANTHROPIC_API_KEY itself
# (or an `ant auth login` profile); it is deliberately not mirrored into
# Settings, so there is only one place a stale key can hide.
# ANTHROPIC_API_KEY=

# Which backend reads the annual reports. The prefix picks it, and it is the
# only setting that decides which balance a backfill spends:
#
#   claude-opus-5              Developer Platform API   needs ANTHROPIC_API_KEY
#   cli:claude-opus-5          Claude Code CLI          your Claude subscription
#   cli:                       Claude Code CLI, default model
#   local:qwen2.5-7b-instruct  LM Studio                free, and much weaker
#
# `cli:` needs the `claude` binary on PATH and no key at all. It is the most
# expensive per report of the three (no batching, no cache reuse, and the PDF
# is flattened to text before it is sent) but it draws on a subscription you
# already pay for. The batch commands cannot use it — batching is an API
# feature — so a backfill at scale still wants the API path.
SA_EXTRACTION_MODEL=cli:claude-opus-5
SA_EXTRACTION_MAX_PAGES=60
SA_FILING_YEARS=3

# Rows at or above this confidence reach fundamentals_annual. Below it they
# are queued for review only. 1.0 means "every validator passed".
SA_MIN_PERSIST_CONFIDENCE=0.6

# Serving database (optional) — needs the extra: `uv pip install -e '.[postgres]'`.
# DuckDB stays the engine; `stockanalysis publish` copies the tables the API
# reads into Postgres and swaps them in atomically. Leave SA_PG_DSN unset and
# nothing changes: the publish step skips and the API serves DuckDB.
# Use a direct connection string, not a transaction-mode pooler URL.
SA_PG_DSN=postgresql://localhost/stockanalysis

# The live schema the API reads, and how many previous releases to keep for
# `stockanalysis publish --rollback`.
# SA_PG_SCHEMA=site
# SA_PG_KEEP_RELEASES=1

# Which database the API reads. Switch to postgres once a publish has run.
SA_SERVE_BACKEND=postgres

# Sign-in (the `/v1/me*` routes). The site's Better Auth issues short-lived
# EdDSA tokens; the API checks them against the site's public keys. Issuer and
# audience are both the site's BETTER_AUTH_URL (web/.env.example). Leave all
# three unset and `/v1/me*` answers 503. Before the site can sign anyone in,
# create the schema its accounts live in, then its tables:
#   stockanalysis setup-accounts && npm --prefix web run auth:migrate
SA_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
SA_AUTH_ISSUER=http://localhost:3000
SA_AUTH_AUDIENCE=http://localhost:3000

# Portfolios live in their own schema beside `site`, written by the API and
# never by publish. Locally SA_PG_DSN's role does everything. Elsewhere, a
# separate login that can write this schema but not `site` (README, "Separate
# Postgres roles" — it needs the schema's tables, not only the schema). Unset,
# the portfolio pool uses SA_PG_DSN.
# SA_PG_APP_DSN=postgresql://sa_app:<password>@localhost/stockanalysis
# SA_PG_APP_SCHEMA=app

# Roles that may read the published data, as a JSON list. Each publish grants
# them USAGE and SELECT on the new release, and a rollback on the release it
# brings back; the release live before this is set needs one grant by hand.
# SA_PG_READ_ROLES=["sa_app"]
