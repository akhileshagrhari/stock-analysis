    "/v1/instruments/{isin}/financials": {
      "get": {
        "tags": [
          "financials"
        ],
        "summary": "Financials",
        "description": "Reported figures, newest first, in ₹ crore except EPS.\n\nEvery stored year comes back whatever its basis. A company that moved from\nstandalone to consolidated shows the move rather than losing a year, and a\nclient computing growth across it should say so — see\n`queries.annual_financials`. Empty lists, not a 404, for a listed company\nwith nothing filed yet.",
        "operationId": "financials_v1_instruments__isin__financials_get",
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Isin"
            }
          },
          {
            "name": "quarters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 40,
              "minimum": 1,
              "default": 12,
              "title": "Quarters"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinancialsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/instruments/{isin}/prices": {
      "get": {
        "tags": [
          "prices"
        ],
        "summary": "Price History",
        "description": "Daily bars, oldest first, both ends inclusive.\n\nThe default window ends at the company's latest stored day, not today, so\na chart opens on data even when prices have not been ingested for a while.",
        "operationId": "price_history_v1_instruments__isin__prices_get",
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Isin"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD; defaults to a year before `to`",
              "title": "From"
            },
            "description": "YYYY-MM-DD; defaults to a year before `to`"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD; defaults to the latest stored day",
              "title": "To"
            },
            "description": "YYYY-MM-DD; defaults to the latest stored day"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceBarOut"
                  },
                  "title": "Response Price History V1 Instruments  Isin  Prices Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
