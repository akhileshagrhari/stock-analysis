      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness plus enough state to tell \"empty\" from \"broken\".",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
