    "/v1/instruments/{isin}/explanation": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Signal Explanation",
        "description": "Why the latest signal is what it is: the families that carried it, the\nfactors for and against, the news mix, and any red flag that forced it.\n\nRebuilt from the stored factor scores, never re-scored, so it describes the\nnumber the other routes return — see `serve.explain`.",
        "operationId": "signal_explanation_v1_instruments__isin__explanation_get",
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
