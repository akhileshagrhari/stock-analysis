{
  "openapi": "3.1.0",
  "info": {
    "title": "StockAnalysis API",
    "description": "Factor-based equity research for Indian markets. Scores are percentiles within the scored universe on each date, not absolute valuations.",
    "version": "0.3.0"
  },
