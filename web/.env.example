# Where the FastAPI server is. Server components call it directly; the browser
# reaches it through the /api/v1 proxy route (src/app/api/v1/[...path]/route.ts),
# which reads this at request time and forwards search only.
SA_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Accounts (Better Auth). Leave DATABASE_URL or BETTER_AUTH_SECRET unset and
# accounts are off: no Sign in, no Portfolio. Copy what you need into
# .env.local, which is gitignored. Setup, once per database:
#   .venv/bin/stockanalysis setup-accounts   # creates the `auth` schema
#   npm run auth:migrate                     # creates Better Auth's tables in it

# The Postgres the API serves from. Better Auth keeps accounts and sessions in
# its own schema there (`auth`); it never touches the published `site` schema.
DATABASE_URL=postgresql:///stockanalysis

# Signs sessions and encrypts the JWT signing key. Generate one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's public origin. Sign-in tokens carry it as issuer and audience, so
# the API's SA_AUTH_ISSUER and SA_AUTH_AUDIENCE must match it exactly.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (a free OAuth client in Google Cloud; redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google). Unset hides the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in codes by email, through Resend (resend.com; the free tier covers a
# small site). EMAIL_FROM must be on a domain verified there, e.g.
# "Stock Analysis <signin@example.com>". Unset in development: the code is
# written to the Next.js server log instead. Unset in production: sending a
# code fails.
RESEND_API_KEY=
EMAIL_FROM=

# DEV AND E2E ONLY. Every sign-in code is this value instead of a random one,
# so tests can sign in without reading email. Ignored when NODE_ENV is
# production. Never set it on a deployed site.
# AUTH_DEV_FIXED_OTP=246810
